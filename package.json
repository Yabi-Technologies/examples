{
  "name": "papi-pass-creator-outlook-addin",
  "version": "1.0.0",
  "description": "Outlook Add-in for creating PAPI passes directly from email messages",
  "main": "src/taskpane/taskpane.js",
  "scripts": {
    "start": "office-addin-debugging start manifest.xml desktop",
    "stop": "office-addin-debugging stop manifest.xml",
    "validate": "office-addin-manifest validate manifest.xml",
    "serve": "npx http-server -p 3000 --cors -c-1",
    "dev": "concurrently \"npm run serve\" \"npm run start\""
  },
  "keywords": [
    "outlook",
    "office-add-in",
    "papi",
    "pass-creation",
    "yabi"
  ],
  "author": "Yabi Technologies",
  "license": "MIT",
  "dependencies": {},
  "devDependencies": {
    "http-server": "^14.1.1",
    "office-addin-debugging": "^5.0.0",
    "office-addin-manifest": "^1.13.0",
    "concurrently": "^8.2.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Yabi-Technologies/PAPI.git"
  }
}
